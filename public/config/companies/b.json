      },
      {
        "id": "lottery",
        "name": "彩票",
        "icon": "/icons/b/lottery.svg",
        "order": 3,
        "enabled": true,
        "gameIds": ["b_lottery001", "b_lottery002"]
      }
    ],
    "featured": ["b_slot001", "b_baccarat"],
    "newGames": ["b_lottery002"],
    "popularGames": ["b_slot001", "b_slot002", "b_baccarat"],
    "jackpotGames": ["b_slot001"]
