      "meta": {
        "title": "B 娛樂城 - 簡潔快速的遊戲體驗",
        "description": "B 娛樂城提供簡潔快速的線上博弈體驗，專注於遊戲本身的樂趣",
        "keywords": ["B娛樂城", "快速遊戲", "簡潔介面", "線上博弈"]
      },
      "permissions": ["games_access"],
      "responsive": { "desktop": true, "tablet": true, "mobile": true }
    }
  },
  "games": {
    "categories": [
      {
        "id": "slots",
        "name": "老虎機",
