{
  "companyInfo": {
    "code": "b",
    "name": "B 娛樂城",
    "domain": "b.casino.com",
    "timezone": "Asia/Taipei",
    "currency": "TWD",
    "language": "zh-TW"
  },
  "branding": {
    "theme": "modern",
    "primaryColor": "#2563eb",
    "secondaryColor": "#1e40af",
    "accentColor": "#06b6d4",
    "logo": {
      "main": "/logo/b-main.png",
      "favicon": "/favicon-b.ico"
    },
    "fonts": {
      "primary": "Inter, sans-serif",
      "secondary": "Source Sans Pro, sans-serif"
    }
  },
  "layout": {
    "type": "compact",
    "header": {
      "style": "static",
      "showLogo": true,
      "showNavigation": true,
      "showUserInfo": true
    },
    "sidebar": {
      "enabled": false,
      "position": "right",
      "collapsible": false
    },
    "footer": {
      "enabled": true,
      "content": "minimal"
    }
  },
  "modules": {
    "core": {
      "authentication": true,
      "userProfile": true,
      "wallet": true,
      "gameHistory": true,
      "notifications": true
    },
    "optional": {
      "soundEffects": {
        "enabled": false,
        "volume": 30,
        "sounds": {
          "click": "/sounds/b/click.mp3",
          "hover": "/sounds/b/hover.mp3",
          "win": "/sounds/b/win.mp3",
          "lose": "/sounds/b/lose.mp3",
          "notification": "/sounds/b/notification.mp3"
        },
        "backgroundMusic": {
          "enabled": false,
          "tracks": [],
          "shuffle": false,
          "loop": false
        }
      },
      "leaderboard": {
        "enabled": true,
        "position": "sidebar",
        "updateInterval": 120,
        "categories": ["weekly", "monthly"],
        "displayCount": 5,
        "showAvatars": false,
        "showPrizes": false,
        "autoRefresh": false
      },
      "liveChat": {
        "enabled": true,
        "provider": "crisp",
        "position": "bottom-left",
        "autoOpen": false,
        "workingHours": {
          "enabled": false,
          "timezone": "Asia/Taipei",
          "schedule": {}
        }
      },
      "promotions": {
        "enabled": true,
        "bannerPosition": "top",
        "autoShow": true,
        "showFrequency": "daily",
        "categories": ["welcome", "deposit", "cashback"]
      }
    }
  },
  "pages": {
    "homepage": {
      "layout": "compact",
      "sections": [
        {
          "id": "promotion-banner",
          "type": "component",
          "component": "PromotionBanner",
          "position": { "order": 1 },
          "responsive": { "desktop": true, "tablet": true, "mobile": true }
        },
        {
          "id": "game-categories",
          "type": "component",
          "component": "GameGrid",
          "props": { "category": "all", "limit": 20, "layout": "grid" },
          "position": { "order": 2 },
          "responsive": { "desktop": true, "tablet": true, "mobile": true }
        },
        {
          "id": "news-section",
          "type": "component",
          "component": "NewsSection",
          "position": { "order": 3 },
          "responsive": { "desktop": true, "tablet": false, "mobile": false }
